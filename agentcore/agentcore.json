{
  "name": "SampleDeepAgents",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "agent",
      "modelProvider": "Bedrock",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/agent",
      "runtimeVersion": "PYTHON_3_14",
      "protocol": "HTTP",
      "envVars": [
        { "name": "AWS_GENAI_CONTENT_EXTRACTION_OPT_OUT", "value": "true" }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [
    {
      "name": "eval",
      "agent": "agent",
      "evaluators": [
        "Builtin.Correctness",
        "Builtin.GoalSuccessRate",
        "Builtin.ToolSelectionAccuracy"
      ],
      "samplingRate": 10
    }
  ],
  "agentCoreGateways": [
    {
      "name": "WebSearchGW",
      "protocolType": "MCP",
      "targets": [
        {
          "name": "web-search",
          "targetType": "connector",
          "connectorId": "web-search",
          "configurations": [
            {
              "name": "WebSearch",
              "parameterValues": {
                "maxResults": 10
              }
            }
          ]
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "harnesses": []
}